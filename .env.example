# ─── База ────────────────────────────────────────────────────────────────────
# Кабинет, заявки с лендинга и состояние лицензий. Схема — в migrations/.
# Без переменной сайт поднимается, но /api/v1/license отвечает configured:false
# и НИКОГО не ограничивает. В проде это значит «все ключи бессрочные» — см.
# app/api/v1/license/route.ts.
DATABASE_URL=

# ─── Сессии кабинета ─────────────────────────────────────────────────────────
# Подпись куки klaster_session. В продакшене обязателен: без него lib/auth.ts
# бросает SessionSecretMissingError, а не тихо подписывает dev-ключом.
SESSION_SECRET=

# Белый список почт, которым можно войти в кабинет. Через запятую.
ALLOWED_EMAILS=

# Внешний адрес сайта. Нужен для ссылок входа, уходящих на почту.
NEXT_PUBLIC_APP_URL=https://klastercrm.com

# ─── Проверка подписи amoCRM ─────────────────────────────────────────────────
# /api/v1/license принимает X-Auth-Token — JWT HS256 от amoCRM. Проверяется
# перебором этих секретов.
#
# AMO_CLIENT_SECRET — только для НАШЕЙ публичной интеграции из технического
# аккаунта: её секрет клиенту не виден никогда, поэтому допустим без номера.
AMO_CLIENT_SECRET=
# AMO_CLIENT_SECRETS — приватные интеграции клиентов, ОБЯЗАТЕЛЬНО в виде
# `account_id:секрет`, через запятую. Приватный секрет виден администратору
# клиента, и ключ без привязки принимался бы для ЛЮБОГО аккаунта: клиент со
# своим ключом подписал бы токен с чужим account_id и получил бы чужую
# лицензию. Запись без номера пропускается с предупреждением в лог.
AMO_CLIENT_SECRETS=

# ─── Вход через поставщика (Stack Auth) ──────────────────────────────────────
# Все три пустые — вход по ссылке на почту, страница /handler не поднимается.
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# ─── Отправка кода входа ─────────────────────────────────────────────────────
# Почта через SMTP. Ящик домена заведён в Hostinger, но работает он на Titan
# Mail, и сервер у него СВОЙ: smtp.titan.email. smtp.hostinger.com на те же
# логин и пароль отвечает «535 authentication failed» — проверено 19.09.2026.
#   SMTP_HOST=smtp.titan.email
#   SMTP_PORT=465
#   SMTP_USER=hello@klastercrm.com   (полный адрес ящика)
#   SMTP_PASS=...                      (пароль ящика)
#   SMTP_FROM=KLASTER <hello@klastercrm.com>
# Не заданы — на проде форма входа честно отвечает «не смогли отправить код»,
# а не делает вид, что письмо ушло.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS для входа по телефону. Провайдер — SMSC (покрывает Грузию, Казахстан,
# Россию). Не задан — вкладка «по телефону» на экране входа не показывается.
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=

# Почта владельца Like House для сида кабинета (scripts/db.mjs seed-likehouse).
LIKEHOUSE_EMAIL=
